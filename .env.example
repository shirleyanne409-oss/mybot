# این فایل رو کپی کن به اسم .env و مقادیر واقعی رو داخلش بذار.
# فایل .env هرگز نباید به گیت/جای عمومی آپلود بشه.

# توکن ربات -- از @BotFather می‌گیری
BOT_TOKEN=123456789:AAExampleTokenHere

# آیدی عددیِ تلگرام سوپرادمین(ها)، با کاما جدا شده (بدون فاصله لازم نیست ولی بهتره نباشه)
ADMIN_IDS=1864207596

# اختیاری: فقط اگه سروری که ربات روش اجرا می‌شه نتونه مستقیم به تلگرام وصل بشه لازمه
# (مثلاً اجرای محلی داخل ایران). روی اکثر سرورهای Cloud خارج از ایران این رو خالی بذار.
PROXY_URL=

# اختیاری: برای فعال‌سازی قابلیتِ ساختِ خودکار پیش‌نویسِ «تجربه امتحان» با هوش مصنوعی
ANTHROPIC_API_KEY=

# اختیاری: مسیر فایل دیتابیس SQLite (پیش‌فرض medverse.db در همون پوشه)
# روی Railway (با یه Volume که روی /data مونت شده): MEDVERSE_DB_FILE=/data/medverse.db
MEDVERSE_DB_FILE=medverse.db

# اختیاری: پوشه‌ی مرکزیِ داده‌های Runtime (JSONهایی مثل analytics.json و ...).
# اگه ست نشه، دقیقاً مثل قبل کنار bot.py ذخیره می‌شن (سازگار با اجرای محلی/VPS فعلی).
# روی Railway (با یه Volume که روی /data مونت شده): MEDVERSE_DATA_DIR=/data
MEDVERSE_DATA_DIR=
