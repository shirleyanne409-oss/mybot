+    except TelegramError:
+        pass
+    task = asyncio.create_task(_run_study_broadcast(
+        context.application, "study_ann_running", user_id, query.message.chat_id, recipients,
+        f"📢 اطلاعیه‌ی اتاق مطالعه\n\n{req['text']}", _study_room_buttons(STUDY_ROOM_LINK),
+        "study_announce_broadcast", f"scope={'all' if scope is None else scope}",
+    ))
+    _study_broadcast_tasks.add(task)
