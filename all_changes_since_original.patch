+async def examreq_confirm_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
+    user_id = update.effective_user.id
+    if not (is_admin(user_id) and can_send_exam_request(user_id)):
+        await query.answer("⛔️ مجاز نیستید.", show_alert=True)
+        return
+    req = context.user_data.get("examreq")
+    nonce = query.data.split(":", 1)[1]
+    if not req or req.get("nonce") != nonce:
+        await query.answer("این پیش‌نمایش دیگر معتبر نیست؛ دوباره /examrequest.", show_alert=True)
+        return
+    scope = req["scope"]
+    if (scope is None and not is_super_admin(user_id)) or (scope is not None and not can_manage_term(user_id, scope)):
+        await query.answer("⛔️ مجاز نیستید.", show_alert=True)
+        return
+    bot_data = context.application.bot_data
+    if bot_data.get("exam_request_running"):
+        await query.answer("⏳ یک ارسال در حال انجام است.", show_alert=True)
+        return
+    # nonce یک‌بارمصرف؛ از اینجا تا ست‌شدنِ پرچم await نیست (بدون race)
+    context.user_data.pop("examreq", None)
+    bot_data["exam_request_running"] = True
+    recipients = [uid for uid in dbmod.get_user_ids_for_term(scope) if int(uid) != int(user_id)]
+    await query.answer("ارسال شروع شد…")
+    try:
+        await query.edit_message_text(f"📤 ارسال برای {len(recipients)} نفر شروع شد؛ نتیجه را همین‌جا می‌فرستم.")
+    except TelegramError:
+        pass
+    task = asyncio.create_task(
+        _run_exam_request(context.application, user_id, query.message.chat_id, recipients, req["text"], scope)
+    )
+    _exam_request_tasks.add(task)
+    task.add_done_callback(_exam_request_tasks.discard)
+
+
+async def _run_exam_request(app: Application, sender_id: int, report_chat_id: int, recipients: list, text: str, scope) -> None:
+    sent = blocked = failed = 0
+    try:
+        for uid in recipients:
+            for attempt in range(2):
+                try:
+                    await app.bot.send_message(chat_id=int(uid), text=text, reply_markup=_exam_request_markup())
+                    sent += 1
+                    break
+                except RetryAfter as e:
+                    if attempt == 0:
+                        await asyncio.sleep(float(getattr(e, "retry_after", 1)) + 1)
+                        continue
+                    failed += 1
+                except Forbidden:
+                    blocked += 1
+                    break
+                except Exception:
+                    failed += 1
+                    break
+            await asyncio.sleep(EXAM_REQUEST_SEND_DELAY)
+        try:
+            dbmod.log_action(sender_id, "exam_request_broadcast", term=scope,
+                             detail=f"sent={sent} blocked={blocked} failed={failed}")
+        except Exception:
+            logger.exception("ثبتِ لاگِ درخواستِ مشارکت ناموفق بود.")
+    except Exception:
+        logger.exception("ارسالِ درخواستِ مشارکت با خطا مواجه شد.")
+    finally:
+        app.bot_data["exam_request_running"] = False
+        try:
+            await app.bot.send_message(
+                chat_id=report_chat_id,
+                text=f"📣 نتیجه‌ی ارسالِ درخواستِ مشارکت\n\n✅ موفق: {sent}\n🚫 بلاک/در دسترس نیست: {blocked}\n⚠️ سایر خطاها: {failed}",
+            )
+        except Exception:
+            logger.exception("ارسالِ گزارشِ نتیجه ناموفق بود.")
+
+
+async def adminperm_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """/adminperm list | /adminperm <user_id> <مجوز> on|off  -- فقط SUPER_ADMIN."""
+    if not is_super_admin(update.effective_user.id):
+        return
+    args = context.args or []
+    perms_help = "\n".join(f"• {k} — {v}" for k, v in ADMIN_PERMISSIONS.items())
+    if not args or args[0].lower() == "list":
+        rows = dbmod.list_admin_permissions()
+        lines = [f"• {uid}: {perm}" for uid, perm in rows] or ["هنوز مجوزی داده نشده."]
+        await update.message.reply_text(
+            "🔐 مجوزهای ادمین‌ها:\n" + "\n".join(lines) + f"\n\nمجوزهای موجود:\n{perms_help}\n\n"
+            "استفاده: /adminperm <user_id> <مجوز> on|off"
+        )
+        return
+    if len(args) != 3 or args[2].lower() not in ("on", "off") or args[1] not in ADMIN_PERMISSIONS:
+        await update.message.reply_text(f"فرمت: /adminperm <user_id> <مجوز> on|off\n\n{perms_help}")
+        return
+    try:
+        target = int(args[0])
+    except ValueError:
+        await update.message.reply_text("user_id باید عدد باشد.")
+        return
+    if not dbmod.get_admin_roles(target):
+        await update.message.reply_text("این کاربر ادمین نیست؛ اول با /addadmin او را ادمین کن.")
+        return
+    enabled = args[2].lower() == "on"
+    dbmod.set_admin_permission(target, args[1], enabled, granted_by=update.effective_user.id)
+    dbmod.log_action(update.effective_user.id, "ADMIN_PERMISSION", detail=f"user={target} perm={args[1]} on={enabled}")
+    await update.message.reply_text(("✅ مجوز فعال شد." if enabled else "✅ مجوز غیرفعال شد.") + f"\n{target} ← {args[1]}")
