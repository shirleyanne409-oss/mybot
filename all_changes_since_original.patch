+async def _study_send_one(bot, chat_id: int, text: str, markup) -> str:
+    for attempt in range(2):
+        try:
+            await bot.send_message(chat_id=int(chat_id), text=text, reply_markup=markup, disable_web_page_preview=True)
+            return "sent"
+        except RetryAfter as e:
+            if attempt == 0:
+                await asyncio.sleep(float(getattr(e, "retry_after", 1)) + 1)
+                continue
+            return "failed"
+        except Forbidden:
+            return "blocked"
+        except Exception:
+            return "failed"
+    return "failed"
+
+
+async def _run_study_broadcast(app: Application, flag: str, sender_id: int, report_chat_id: int,
+                               recipients: list, text: str, markup, action: str, detail_prefix: str) -> None:
+    sent = blocked = failed = 0
+    try:
+        for uid in recipients:
+            r = await _study_send_one(app.bot, uid, text, markup)
+            sent += r == "sent"
+            blocked += r == "blocked"
+            failed += r == "failed"
+            await asyncio.sleep(STUDY_INVITE_SEND_DELAY)
+        try:
+            dbmod.log_action(sender_id, action, detail=f"{detail_prefix} sent={sent} blocked={blocked} failed={failed}")
+        except Exception:
+            logger.exception("ثبتِ لاگِ ارسال ناموفق بود.")
+    except Exception:
+        logger.exception("ارسالِ گروهیِ اتاق مطالعه با خطا مواجه شد (%s).", action)
+    finally:
+        app.bot_data[flag] = False
+        try:
+            await app.bot.send_message(
+                chat_id=report_chat_id,
+                text=f"📣 نتیجه‌ی ارسال\n\n✅ موفق: {sent}\n🚫 بلاک/در دسترس نیست: {blocked}\n⚠️ سایر خطاها: {failed}",
+            )
+        except Exception:
+            logger.exception("ارسالِ گزارشِ نتیجه ناموفق بود.")
+
