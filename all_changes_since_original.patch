+    if channelexport.is_running():
+        await update.message.reply_text("⏳ export سراسری در حال اجراست؛ بعد از پایانش دوباره بزن.")
+        return
+    fids = channelexport.failed_fids()
+    if not fids:
+        await update.message.reply_text("✅ فایلِ ناموفقی در صفِ انتشار نیست.")
+        return
+    await update.message.reply_text(f"🔁 تلاش مجدد برای {len(fids)} فایل شروع شد؛ نتیجه را همین‌جا می‌فرستم.")
+    chat_id = update.effective_chat.id
+
+    async def _job() -> None:
+        ok = bad = 0
+        for fid in fids:
+            try:
+                r = await channelexport.publish_one(context.bot, fid)
+            except Exception:
+                logger.exception("retrychannel fid=%s", fid)
+                r = "failed"
+            if r in ("sent", "already"):
+                ok += 1
+            else:
+                bad += 1
+        try:
+            await context.bot.send_message(chat_id=chat_id, text=f"🔁 نتیجه: ✅ {ok} | ⚠️ هنوز ناموفق: {bad}")
+        except Exception:
+            pass
+
+    context.application.create_task(_job())
+
