+async def zip_download_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """zip:crs:<course> | zip:cat:<course>:<cat> | zip:grp:<course>:<cat>:<group>"""
+    query = update.callback_query
+    user_id = update.effective_user.id
+    parts = query.data.split(":")
+    try:
+        kind, ids = parts[1], [int(x) for x in parts[2:]]
+        if (kind, len(ids)) not in (("crs", 1), ("cat", 2), ("grp", 3)):
+            raise ValueError
+    except (ValueError, IndexError):
+        await query.answer("درخواست نامعتبر.", show_alert=True)
+        return
+    if user_id in zipper.active_users:
+        await query.answer("⏳ یک ZIP از خودت در حال آماده‌سازیه؛ صبر کن تا تموم شه.", show_alert=True)
+        return
+    wait = zipper.cooldown_remaining(user_id)
+    if wait:
+        await query.answer(f"⏳ لطفاً {wait} ثانیه‌ی دیگه دوباره تلاش کن.", show_alert=True)
+        return
+    if zipper.busy():
+        await query.answer("ربات الان سرش شلوغه؛ چند دقیقه‌ی دیگه دوباره تلاش کن 🙏", show_alert=True)
+        return
+    await query.answer("درخواستت ثبت شد ✅")
+    zipper.active_users.add(user_id)
+    zipper.mark_request(user_id)
+    chat_id = query.message.chat_id
+    status = await context.bot.send_message(
+        chat_id=chat_id,
+        text="📦 دارم ZIP رو آماده می‌کنم؛ بسته به تعداد و حجم فایل‌ها ممکنه چند دقیقه طول بکشه. ربات در این مدت برای بقیه هم کار می‌کنه.",
+    )
+
+    async def _job() -> None:
+        try:
+            result = await zipper.run_zip_job(context.bot, chat_id, kind, ids)
+        except Exception:
+            logger.exception("ساخت/ارسالِ ZIP با خطا مواجه شد (user=%s)", user_id)
+            result = {"status": "error"}
+        finally:
+            zipper.active_users.discard(user_id)
+        st = result.get("status")
+        if st == "empty":
+            msg = "این بخش هنوز فایلی ندارد. 🌱"
+        elif st == "missing":
+            msg = "این بخش دیگه پیدا نشد؛ شاید حذف شده."
+        elif st == "busy":
+            msg = "ربات الان سرش شلوغه؛ چند دقیقه‌ی دیگه دوباره تلاش کن 🙏"
+        elif st == "too_many":
+            msg = (f"این محدوده {result.get('count')} فایل دارد و برای یک ZIP زیاد است. "
+                   "لطفاً از یک زیربخش کوچک‌تر (مثلاً یک استاد یا یک دسته) استفاده کن.")
+        elif st == "send_failed":
+            msg = "ارسالِ ZIP با مشکل روبه‌رو شد. چند دقیقه بعد دوباره امتحان کن؛ فایل‌های اصلی دست‌نخورده‌اند."
+        elif st == "ok":
+            if result["parts"] == 0:
+                msg = "هیچ فایلی قابل ارسال نبود."
+            else:
+                msg = f"✅ {result['included']} فایل در {result['parts']} ZIP ارسال شد."
+                if result.get("texts"):
+                    msg += f"\n📝 {result['texts']} متن/لینک داخل README.txt آمده."
+            if result["skipped"]:
+                shown = "\n".join(f"• {name} — {why}" for name, why in result["skipped"][:15])
+                more = len(result["skipped"]) - 15
+                msg += f"\n\n⚠️ ارسال نشد ({len(result['skipped'])}):\n{shown}" + (f"\n… و {more} مورد دیگر" if more > 0 else "")
+        else:
+            msg = "مشکلی پیش اومد؛ چند دقیقه بعد دوباره امتحان کن. فایل‌های اصلی دست‌نخورده‌اند."
+        try:
+            await context.bot.send_message(chat_id=chat_id, text=msg[:4000])
+        except Exception:
+            logger.exception("ارسالِ نتیجه‌ی ZIP ناموفق بود")
+        try:
+            await status.delete()
+        except Exception:
+            pass
+
+    context.application.create_task(_job())
