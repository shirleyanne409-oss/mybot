+async def pshare_make_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
+    user_id = update.effective_user.id
+    schedule = load_personal_schedule().get(str(user_id), {})
+    snapshot = {
+        day: [{"start": b.get("start"), "end": b.get("end"), "course": b.get("course")} for b in schedule.get(day, [])]
+        for day in DAYS_OF_WEEK if schedule.get(day)
