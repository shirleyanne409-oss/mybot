+async def personal_room_start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
+    user_id = update.effective_user.id
+    term = get_user_class_program(user_id)
+    if not term:
+        await query.answer("اول ترمت را انتخاب کن (📅 برنامه شخصی ← 🔁 تغییر ترم).", show_alert=True)
+        return
+    allowed, wait = dbmod.personal_room_limits(user_id)
+    if not allowed:
+        msg = (f"⏳ حدود {wait} دقیقه‌ی دیگر می‌توانی دوباره دعوت بفرستی." if wait > 0
+               else "امروز به سقفِ ۳ دعوتِ شخصی رسیدی؛ فردا دوباره امتحان کن.")
+        await query.answer(msg, show_alert=True)
+        return
+    await query.answer()
+    context.user_data["proom"] = {"step": "link", "term": term}
+    await query.message.reply_text(
+        "🏠 اتاق مطالعه‌ی شخصی\n\nاول در درسیتا یک اتاق بساز، بعد لینک دعوتش را همین‌جا بفرست "
+        "(به شکل https://app.darsita.ir/study-rooms/join/...).\nدعوت فقط برای هم‌ترمی‌هایت فرستاده می‌شود.",
+        reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("✖️ انصراف", callback_data="proom_cancel")]]),
+    )
+
+
+async def personal_room_cancel(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    context.user_data.pop("proom", None)
+    await update.callback_query.answer("لغو شد.")
+    try:
+        await update.callback_query.edit_message_text("✖️ لغو شد. چیزی فرستاده نشد.")
+    except TelegramError:
+        pass
+
+
+async def personal_room_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
+    user_id = update.effective_user.id
+    import time as _time
+    req = context.user_data.get("proom")
+    nonce = query.data.split(":", 1)[1]
+    if not req or req.get("step") != "ready" or req.get("nonce") != nonce:
+        await query.answer("این پیش‌نمایش دیگر معتبر نیست؛ دوباره شروع کن.", show_alert=True)
+        return
+    term = get_user_class_program(user_id)
+    if not term or term != req["term"]:
+        await query.answer("ترمت تغییر کرده؛ دوباره شروع کن.", show_alert=True)
+        return
+    allowed, _wait = dbmod.personal_room_limits(user_id)
+    bot_data = context.application.bot_data
+    if not allowed or bot_data.get("study_personal_running"):
+        await query.answer("⏳ الان امکانِ ارسال نیست؛ کمی بعد دوباره امتحان کن.", show_alert=True)
+        return
+    context.user_data.pop("proom", None)
+    bot_data["study_personal_running"] = True
+    recipients = _study_term_recipients(user_id, term)
+    try:
+        dbmod.add_personal_study_room(user_id, term, req["link"], req["text"], len(recipients))
+    except Exception:
+        bot_data["study_personal_running"] = False
+        logger.exception("ثبتِ اتاقِ شخصی ناموفق بود (user=%s)", user_id)
+        await query.answer("مشکلی پیش اومد، دوباره امتحان کن 🙏", show_alert=True)
+        return
+    await query.answer("ارسال شروع شد…")
+    try:
+        await query.edit_message_text(f"📤 دعوت برای {len(recipients)} هم‌ترمی شروع شد؛ نتیجه را همین‌جا می‌فرستم.")
+    except TelegramError:
+        pass
+    body = f"🏠 دعوت به اتاق مطالعه از طرف {_personal_room_nickname(user_id)}"
+    if req["text"]:
+        body += f"\n\n{req['text']}"
+    task = asyncio.create_task(_run_study_broadcast(
+        context.application, "study_personal_running", user_id, query.message.chat_id, recipients,
+        body, _study_room_buttons(req["link"]), "personal_study_room_broadcast", f"term={term}",
+    ))
+    _study_broadcast_tasks.add(task)
+    task.add_done_callback(_study_broadcast_tasks.discard)
+
+
+async def study_text_input(update: Update, context: ContextTypes.DEFAULT_TYPE) -> bool:
+    """متن‌های ورودیِ اتاق شخصی (لینک/متن) و اطلاعیه. True یعنی پیام مصرف شد."""
+    text = (update.message.text or "").strip()
+    user_id = update.effective_user.id
+    # --- اطلاعیه ---
+    if context.user_data.get("studyann_awaiting"):
+        req = context.user_data.get("studyann")
+        context.user_data.pop("studyann_awaiting", None)
+        if not req or not can_send_study_announce(user_id):
+            return True
+        if not text or len(text) > STUDY_ANNOUNCE_MAX_TEXT:
+            context.user_data["studyann_awaiting"] = True
+            await update.message.reply_text(f"متن باید خالی نباشد و حداکثر {STUDY_ANNOUNCE_MAX_TEXT} نویسه باشد؛ دوباره بفرست.")
+            return True
+        req["text"] = text
+        req["nonce"] = uuid.uuid4().hex[:10]
+        scope = req["scope"]
+        count = len(_study_term_recipients(user_id, scope))
+        await update.message.reply_text(
+            f"📢 پیش‌نمایشِ اطلاعیه\n──────────────\n{text}\n──────────────\n"
+            f"🎯 مخاطبان: {'همه‌ی ترم‌ها' if scope is None else scope} — حدود {count} نفر (اعلان اتاق مطالعه روشن)",
+            reply_markup=InlineKeyboardMarkup([
+                [InlineKeyboardButton("✅ تأیید و ارسال", callback_data=f"studyann_ok:{req['nonce']}")],
+                [InlineKeyboardButton("✖️ انصراف", callback_data="studyann_cancel")],
+            ]),
+        )
+        return True
+    # --- اتاق شخصی ---
+    req = context.user_data.get("proom")
+    if not req:
+        return False
+    if req["step"] == "link":
+        if not PERSONAL_ROOM_LINK_RE.match(text):
+            await update.message.reply_text("لینک معتبر نیست. باید دقیقاً شبیه این باشد:\nhttps://app.darsita.ir/study-rooms/join/xxxx")
+            return True
+        if text == STUDY_ROOM_LINK:
+            await update.message.reply_text("این لینکِ اتاقِ رسمیِ MedVerse است؛ لینکِ اتاقِ شخصیِ خودت را بفرست.")
+            return True
+        req["link"] = text
+        req["step"] = "text"
+        await update.message.reply_text(f"یک متن کوتاه برای هم‌کلاسی‌ها بنویس (حداکثر {PERSONAL_ROOM_MAX_TEXT} نویسه)، یا «-» بفرست تا بدون متن ارسال شود.")
+        return True
+    if req["step"] == "text":
+        if len(text) > PERSONAL_ROOM_MAX_TEXT or not text:
+            await update.message.reply_text(f"حداکثر {PERSONAL_ROOM_MAX_TEXT} نویسه؛ دوباره بفرست (یا «-»).")
+            return True
+        req["text"] = "" if text == "-" else text
+        req["step"] = "ready"
+        req["nonce"] = uuid.uuid4().hex[:10]
+        count = len(_study_term_recipients(user_id, req["term"]))
+        await update.message.reply_text(
+            "🏠 پیش‌نمایشِ دعوت\n──────────────\n"
+            f"از طرف {_personal_room_nickname(user_id)}\n{req['text'] or '(بدون متن)'}\n🔗 {req['link']}\n──────────────\n"
+            f"🎯 هم‌ترمی‌ها ({req['term']}) — حدود {count} نفر (اعلان اتاق مطالعه روشن)\n"
+            "نامِ لقب‌ات (نه آیدی/شماره) نمایش داده می‌شود.",
+            reply_markup=InlineKeyboardMarkup([
+                [InlineKeyboardButton("✅ تأیید و ارسال", callback_data=f"proom_ok:{req['nonce']}")],
+                [InlineKeyboardButton("✖️ انصراف", callback_data="proom_cancel")],
+            ]),
+            disable_web_page_preview=True,
+        )
+        return True
+    return False
+
