+def _slot_end_label(start: str) -> str:
+    h, m = map(int, start.split(":"))
+    end = (h * 60 + m + dbmod.STUDY_SLOT_MINUTES) % 1440
+    return f"{end // 60:02d}:{end % 60:02d}"
+
+
+def _slot_ended(start: str, now_dt) -> bool:
+    h, m = map(int, start.split(":"))
+    end_min = h * 60 + m + dbmod.STUDY_SLOT_MINUTES
+    if end_min > 1440:  # از نیمه‌شب رد می‌شود؛ در همان تاریخ تا آخر روز فعال می‌ماند
+        return False
+    return now_dt.hour * 60 + now_dt.minute >= end_min
+
