+    buttons = []
+    for i, start in enumerate(slots):
+        label = f"{start} – {_slot_end_label(start)}"
+        n = counts.get(i, 0)
+        lines.append(f"• {label} — {n} نفر ثبت‌نام")
+        if i in mine:
+            buttons.append([InlineKeyboardButton(f"✅ ثبت‌نام شدی — {label}", callback_data=f"sslot_have:{i}")])
+        elif _slot_ended(start, now_dt):
