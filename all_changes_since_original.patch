+def _study_room_buttons(link: str) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup([
+        [InlineKeyboardButton("🚪 ورود به اتاق مطالعه", url=link)],
+        [_study_notify_button(True)],
+    ])
