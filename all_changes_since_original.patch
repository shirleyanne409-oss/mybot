+# ============================================================
+# 🔗 اشتراک‌گذاریِ محتوا با لینک (برای همه‌ی کاربران)
+# از همان سازوکارِ `/start <payload>` استفاده می‌شود؛ payloadها: file_<fid> (قبلی)،
+# crs_<course_id>، cat_<course_id>_<cat_id>، grp_<course_id>_<cat_id>_<group_id>، sch_<token>.
+# لینک فقط یک پیام با دکمه‌ی «باز کردن» می‌فرستد که همان callbackهای موجود (course:/cat:/fgrp:) را
+# صدا می‌زند؛ پس دسترسی‌ها و منوها هیچ سیستمِ موازی‌ای ندارند.
+# ============================================================
+
+SHARE_DEEPLINK_PREFIXES = ("crs_", "cat_", "grp_", "sch_")
+
+
+def _share_link(bot_username: str, payload: str) -> str:
+    username = (bot_username or "MedVersegoums_bot").lstrip("@")
+    return f"https://t.me/{username}?start={payload}"
+
+
+async def _send_share_message(query, title: str, link: str) -> None:
+    share_url = f"https://t.me/share/url?url={_urlquote(link, safe='')}&text={_urlquote(title, safe='')}"
+    await query.message.reply_text(
+        f"🔗 لینکِ اشتراک‌گذاریِ {title}:\n\n{link}\n\n"
+        "هر کسی این لینک را باز کند مستقیم به همین بخش می‌رسد.",
+        reply_markup=InlineKeyboardMarkup([
+            [InlineKeyboardButton("📤 ارسال برای دوستان", url=share_url)],
+        ]),
+    )
+
+
+def _resolve_share_target(kind: str, ids: list):
+    """(title, payload, open_callback) یا None اگر محتوا وجود ندارد/با هم نمی‌خواند."""
+    if kind == "crs" and len(ids) == 1:
+        ref = dbmod.get_course_by_id(ids[0])
+        if ref:
+            return f"📚 «{ref['name']}» ({ref['term_name']})", f"crs_{ids[0]}", f"course:{ids[0]}"
+    elif kind == "cat" and len(ids) == 2:
+        ref = dbmod.get_course_by_id(ids[0])
+        cat = dbmod.get_category_by_id(ids[1])
+        if ref and cat and cat["course_id"] == ids[0]:
+            return f"📂 «{cat['name']}» — {ref['name']}", f"cat_{ids[0]}_{ids[1]}", f"cat:{ids[0]}:{ids[1]}"
+    elif kind == "grp" and len(ids) == 3:
+        ref = dbmod.get_course_by_id(ids[0])
+        cat = dbmod.get_category_by_id(ids[1])
+        grp = dbmod.get_file_group(ids[2])
+        if (ref and cat and grp and cat["course_id"] == ids[0]
+                and grp.get("course_id") == ids[0] and grp.get("category_id") == ids[1]):
+            return (f"📁 «{grp['name']}» — {cat['name']} — {ref['name']}",
+                    f"grp_{ids[0]}_{ids[1]}_{ids[2]}", f"fgrp:{ids[0]}:{ids[1]}:{ids[2]}")
+    return None
+
+
+async def share_link_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """share:crs:<course> | share:cat:<course>:<cat> | share:grp:<course>:<cat>:<group>"""
+    query = update.callback_query
+    parts = query.data.split(":")
+    try:
+        target = _resolve_share_target(parts[1], [int(x) for x in parts[2:]])
+    except (ValueError, IndexError):
+        target = None
+    if target is None:
+        await query.answer("این بخش دیگه پیدا نشد.", show_alert=True)
+        return
+    await query.answer()
+    title, payload, _cb = target
+    await _send_share_message(query, title, _share_link(getattr(context.bot, "username", None), payload))
+
+
+def _share_button(kind: str, *ids) -> list:
+    return [InlineKeyboardButton("🔗 اشتراک‌گذاری لینک", callback_data="share:" + ":".join([kind, *[str(i) for i in ids]]))]
+
+
+def _render_schedule_snapshot(snapshot_json: str) -> str:
+    try:
+        snap = json.loads(snapshot_json)
+    except (TypeError, ValueError):
+        return ""
+    lines = ["📖 برنامه‌ی مطالعه‌ی اشتراکی (فقط‌خواندنی)", "──────────────"]
+    any_block = False
+    for day in DAYS_OF_WEEK:
+        blocks = snap.get(day) or []
+        if not blocks:
+            continue
+        any_block = True
+        lines.append(f"\n📅 {day}")
+        for b in blocks:
+            lines.append(f"  • {b.get('start', '?')}–{b.get('end', '?')}  {b.get('course', '')}")
+    if not any_block:
+        return ""
+    lines.append("\n(این یک نسخه‌ی ثابت از برنامه‌ی صاحبِ لینک است؛ اطلاعاتِ شخصیِ او نمایش داده نمی‌شود.)")
+    return "\n".join(lines)
+
+
+async def open_shared_deeplink(context: ContextTypes.DEFAULT_TYPE, chat_id: int, payload: str) -> bool:
+    """True اگر لینک معتبر بود و چیزی برای کاربر فرستاده شد."""
+    kind, _, rest = payload.partition("_")
+    if kind == "sch":
+        snap = dbmod.get_active_schedule_share_snapshot(rest)
+        text = _render_schedule_snapshot(snap) if snap else ""
+        if not text:
+            return False
+        await context.bot.send_message(chat_id=chat_id, text=text[:4000])
+        return True
+    try:
+        ids = [int(x) for x in rest.split("_")]
+    except ValueError:
+        return False
+    target = _resolve_share_target(kind, ids)
+    if target is None:
+        return False
+    title, _payload, open_cb = target
+    await context.bot.send_message(
+        chat_id=chat_id,
+        text=f"{title}\n\nاین بخش با لینک برات فرستاده شد:",
+        reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("📂 باز کردن", callback_data=open_cb)]]),
+    )
+    return True
