+            if not await close_and_send(part_no):
+                return {"status": "send_failed", "parts": parts_sent, "included": included, "skipped": skipped}
+        finally:
+            if state["zf"] is not None:
+                try:
+                    state["zf"].close()
+                except Exception:
+                    pass
