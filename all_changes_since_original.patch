+        await query.answer("مشکلی پیش اومد، دوباره امتحان کن 🙏", show_alert=True)
+        return
+    await query.answer("لینک ساخته شد ✅")
+    await _send_share_message(query, "برنامه‌ی مطالعه‌ات", _share_link(getattr(context.bot, "username", None), f"sch_{token}"))
