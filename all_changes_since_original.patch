+async def study_announce_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    query = update.callback_query
+    user_id = update.effective_user.id
+    import time as _time
+    if not can_send_study_announce(user_id):
+        await query.answer("⛔️ مجاز نیستید.", show_alert=True)
+        return
+    req = context.user_data.get("studyann")
+    nonce = query.data.split(":", 1)[1]
+    if not req or req.get("nonce") != nonce or not req.get("text"):
+        await query.answer("این پیش‌نمایش دیگر معتبر نیست؛ دوباره شروع کن.", show_alert=True)
+        return
+    scope = req["scope"]
+    if (scope is None and not is_super_admin(user_id)) or (scope is not None and not can_manage_term(user_id, scope)):
+        await query.answer("⛔️ مجاز نیستید.", show_alert=True)
+        return
+    left = STUDY_ANNOUNCE_COOLDOWN_SECONDS - (_time.time() - _study_ann_last.get(user_id, 0))
+    bot_data = context.application.bot_data
+    if bot_data.get("study_ann_running") or left > 0:
+        await query.answer("⏳ یک ارسال در جریانه یا به‌تازگی انجام شده؛ کمی بعد دوباره تلاش کن.", show_alert=True)
+        return
