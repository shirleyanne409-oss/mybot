+        await query.answer("این درخواست دیگر قابل پاسخ نیست.", show_alert=True)
+        return
+    l = get_listing(chat["listing_id"])
+    await query.answer()
+    if l and l["kind"] == KIND_REQ:
+        # درخواست‌کننده پیش از آغازِ گفت‌وگو یک جمله برای تأییدِ قصدش می‌نویسد
+        clear_state(context)
